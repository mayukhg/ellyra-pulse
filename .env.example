# Copy to .env and fill in — or let start.sh/start.ps1 generate the secrets for you on first run.
# .env is gitignored; never commit real secrets.

# Required. Signs/verifies workforce session JWTs (src/backend/auth.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# Required. Signs/verifies the machine-to-machine ingestion request (§5.7).
# Generate the same way as AUTH_JWT_SECRET.
INGEST_HMAC_SECRET=

# Optional. If unset, the backend uses the in-memory store seeded from data/synthetic/.
# Run scripts/setup-postgres.sh first, or use start.sh/start.ps1 --with-postgres.
# DATABASE_URL=postgres://ellyra:ellyra_dev_pw@127.0.0.1:5432/ellyra_pulse

# Optional. Clinical on-call paging webhook (PagerDuty Events API v2 shape) for P0 routes.
# Without it, P0 pages are logged to the console instead (src/backend/paging.ts).
# PAGER_WEBHOOK_URL=
# PAGER_ROUTING_KEY=

# Optional. Hotjar behavioural telemetry (src/lib/hotjar.ts). Hotjar only loads in the browser
# and only when VITE_HOTJAR_SITE_ID is set. These are VITE_* (not NEXT_PUBLIC_*) because this
# is a Vite/TanStack Start app; they are inlined into the client bundle at build time.
# VITE_ENABLE_HOTJAR_DEBUG=true turns on Hotjar debug logging AND compiles the dev tooling
# (QA harness via ?debug=hotjar, /dev/hotjar-insights) into non-dev builds — set it to false
# (or leave it unset) for production builds.
VITE_HOTJAR_SITE_ID=1058676
VITE_HOTJAR_VERSION=6
VITE_ENABLE_HOTJAR_DEBUG=true

# Optional. "shadow" runs the full ingestion pipeline without persisting or paging — for
# validating production traffic before enabling writes (Phase 3). Defaults to "live".
# INGESTION_MODE=live

# Optional. Mixpanel product analytics. This app is Vite, so the client reads
# NEXT_PUBLIC_MIXPANEL_TOKEN (exposed via vite envPrefix) or VITE_MIXPANEL_TOKEN.
# Leave the token unset to disable client tracking. Do not commit real values.
# NEXT_PUBLIC_MIXPANEL_TOKEN=
# VITE_MIXPANEL_TOKEN=
#
# Server-only. Used by `bun run mixpanel:import` to backfill historical events
# through Mixpanel's /import API. Never put these in client code.
# MIXPANEL_SERVICE_ACCOUNT_USERNAME=
# MIXPANEL_SERVICE_ACCOUNT_SECRET=
# MIXPANEL_PROJECT_ID=
# Set to true only when the Mixpanel project uses EU data residency.
# MIXPANEL_EU_RESIDENCY=false
# NEXT_PUBLIC_MIXPANEL_EU_RESIDENCY=false
