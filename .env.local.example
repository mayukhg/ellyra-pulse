# Copy to .env.local (gitignored) and fill in real values.
# This app also loads .env — see .env.example for the full variable list.

NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token
MIXPANEL_SERVICE_ACCOUNT_USERNAME=your_service_account_user
MIXPANEL_SERVICE_ACCOUNT_SECRET=your_service_account_secret
MIXPANEL_PROJECT_ID=your_project_id
